# Penn Free Food — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Supabase ---
# Project URL (Supabase dashboard → Project Settings → Data API).
NEXT_PUBLIC_SUPABASE_URL=

# NEW publishable API key (NOT the legacy `anon` JWT). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEW secret API key (NOT the legacy `service_role` JWT). SERVER ONLY.
# Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- AI (OpenRouter vision classifier) ---
# Server-only. Used for the photo → fields classifier. Never sent to the client.
OPENROUTER_API_KEY=
# Vision-capable model slug (open question §11 — choose empirically).
OPENROUTER_MODEL=

# --- Map (MapLibre) ---
# Tile provider is an open question (PRD §11). If the chosen provider needs a
# key/style URL, add it here (publishable values may use NEXT_PUBLIC_).
# NEXT_PUBLIC_MAP_TILE_URL=
